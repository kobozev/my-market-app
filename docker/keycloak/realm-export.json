{
  "realm": "market-realm",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "payments",
      "protocol": "openid-connect"
    }
  ],
  "clients": [
    {
      "clientId": "payment-service",
      "enabled": true,
